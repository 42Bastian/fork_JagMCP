# Taken from NGA (../../NGA/.clang-tidy): the checks and options below are kept
# identical to it, so that the owner's projects hold code to one standard. Only
# the comments that explained NGA's own circumstances were rewritten.
#
# Naming rules live here rather than in prose: readability-identifier-naming is
# the only mechanism that actually enforces them.
Checks: >
  bugprone-*,
  performance-*,
  modernize-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -modernize-use-trailing-return-type,
  -modernize-use-std-print,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-braces-around-statements,
  -readability-function-cognitive-complexity,
  -readability-trailing-comma,
  -readability-redundant-member-init,
  -readability-qualified-auto,
  -bugprone-signed-bitwise

# modernize-use-std-print is off because std::print is part of the C++23 subset
# we cannot use: libc++ on Apple clang does not ship it.
#
# readability-magic-numbers is off because an emulator is made of them: register
# addresses, bit positions and clock ratios are copied from the netlist and SoftRef,
# and naming each one would hide which line of the reference it came from.
#
# readability-trailing-comma is off because layout is `.clang-format`'s to
# decide and nothing should hold two opinions about one thing: a trailing comma
# is also what makes the formatter break a list one element to a line.
#
# readability-redundant-member-init is off because a `{}` on a member is what
# lets a designated initializer omit it. Without one, clang's
# -Wmissing-designated-field-initializers fires at every call site that does
# not name the member, and GCC's -Wmissing-field-initializers is the same
# opinion under -Wextra.
#
# readability-qualified-auto is off because it asks for the one spelling that
# does not compile everywhere. A standard container's iterator is a raw pointer
# on libc++ and a class type on MSVC, so the check reads the libc++ type and
# demands `auto const* const`, which then fails to deduce on MSVC.
#
# bugprone-signed-bitwise is listed only to stay identical to NGA. Bit fields of
# the emulated hardware are held in unsigned fixed-width types by convention
# (see CLAUDE.md), so signed bitwise operations are rare and deliberate here.

WarningsAsErrors: ''
HeaderFilterRegex: '.*/(src|tests)/.*'

CheckOptions:
  # Types: CamelCase
  readability-identifier-naming.ClassCase:                 CamelCase
  readability-identifier-naming.StructCase:                CamelCase
  readability-identifier-naming.EnumCase:                  CamelCase
  readability-identifier-naming.UnionCase:                 CamelCase
  readability-identifier-naming.TypeAliasCase:             CamelCase
  readability-identifier-naming.TypedefCase:               CamelCase
  readability-identifier-naming.ConceptCase:               CamelCase

  # Functions and variables: camelBack
  readability-identifier-naming.FunctionCase:              camelBack
  readability-identifier-naming.MethodCase:                camelBack
  readability-identifier-naming.VariableCase:              camelBack
  readability-identifier-naming.ParameterCase:             camelBack

  # Data members: class members are private and prefixed, struct members are not
  readability-identifier-naming.PrivateMemberPrefix:       m
  readability-identifier-naming.PrivateMemberCase:         CamelCase
  readability-identifier-naming.ProtectedMemberPrefix:     m
  readability-identifier-naming.ProtectedMemberCase:       CamelCase
  readability-identifier-naming.PublicMemberCase:          camelBack

  # Constants: UPPER_CASE at namespace and class scope, ordinary inside functions
  readability-identifier-naming.GlobalConstantCase:        UPPER_CASE
  readability-identifier-naming.ClassConstantCase:         UPPER_CASE
  readability-identifier-naming.StaticConstantCase:        UPPER_CASE
  readability-identifier-naming.EnumConstantCase:          UPPER_CASE
  readability-identifier-naming.LocalConstantCase:         camelBack
  readability-identifier-naming.MacroDefinitionCase:       UPPER_CASE

  # Namespaces and template parameters
  readability-identifier-naming.NamespaceCase:             lower_case
  readability-identifier-naming.TypeTemplateParameterCase: CamelCase
  readability-identifier-naming.ValueTemplateParameterCase: UPPER_CASE
